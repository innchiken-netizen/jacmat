# JACMAT STORE — Configuration d'environnement (Exemple)
# Copiez ce fichier vers .env.local pour le développement local.
# Sur Vercel, ajoutez ces variables dans : Project Settings > Environment Variables

# ==============================================================================
# SÉCURITÉ & AUTHENTIFICATION ADMIN (OBLIGATOIRE)
# ==============================================================================

# Adresse email de l'administrateur de la boutique
ADMIN_EMAIL=admin@jacmat.store

# Hachage bcrypt (coût 12) du mot de passe admin
# Générez-le avec la commande : npm run admin:hash-password
ADMIN_PASSWORD_HASH=

# Clé secrète cryptographique aléatoire pour la signature des sessions JWT (min. 32 caractères)
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ==============================================================================
# BASE DE DONNÉES (POSTGRESQL / NEON / SUPABASE)
# ==============================================================================

# Optionnel en local (utilise automatiquement data/store.json si vide).
# Requis pour la production sur Vercel :
# DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/jacmat?sslmode=require
DATABASE_URL=

# ==============================================================================
# STOCKAGE D'IMAGES (OPTIONNEL - VERCEL BLOB / CLOUDINARY)
# ==============================================================================

# Token Vercel Blob (si activé sur votre projet Vercel)
BLOB_READ_WRITE_TOKEN=

# Ou Cloudinary URL (si vous utilisez Cloudinary)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ==============================================================================
# CONFIGURATION PUBLIQUE CLIENT
# ==============================================================================

# Web3Forms API Key pour la réception des commandes par email
VITE_WEB3FORMS_ACCESS_KEY=b381bcb5-2bba-4e6b-a483-c36a6fdafaf8

# Numéro WhatsApp officiel pour la conciergerie et commandes rapides (+243 82 320 7915)
VITE_WHATSAPP_PHONE=243823207915

# Google Analytics 4 Measurement ID
VITE_GA_ID=G-YK5QZMXE8J

# URL du site de production
VITE_SITE_URL=https://jacmat.store
